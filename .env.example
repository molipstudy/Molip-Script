VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY
VITE_SUPABASE_PUBLISHABLE_KEY=YOUR_SUPABASE_PUBLISHABLE_KEY
VITE_SUPABASE_SCHEMA=molip_script

# Vercel server only: needed for administrator email changes. Never prefix with VITE_.
SUPABASE_SECRET_KEY=
# Legacy service_role keys may instead use SUPABASE_SERVICE_ROLE_KEY.

# Server-only visitor analytics (Vercel Functions and npm run dev).
# Never add VITE_ to the token. Restart npm run dev after changing .env.local.
MOLIP_VERCEL_ANALYTICS_TOKEN=
MOLIP_VERCEL_PROJECT_ID=
MOLIP_VERCEL_TEAM_ID=
